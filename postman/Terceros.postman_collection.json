                  "pm.test('Responde 200 OK', () => pm.response.to.have.status(200));",
                  "const p = pm.response.json();",
                  "const sufijo = pm.collectionVariables.get('sufijo');",
                  "pm.test('Encuentra las 2 personas naturales de esta ejecución', () => pm.expect(p.totalElementos).to.eql(2));",
                  "pm.test('Pagina de a 1: página 0 de 2', () => {",
                  "    pm.expect(p.contenido.length).to.eql(1);",
                  "    pm.expect(p.pagina).to.eql(0);",
                  "    pm.expect(p.tamanio).to.eql(1);",
                  "    pm.expect(p.totalPaginas).to.eql(2);",
                  "    pm.expect(p.primera).to.be.true;",
                  "    pm.expect(p.ultima).to.be.false;",
                  "});",
                  "pm.test('Ordena por nombre: primero Ana María', () => pm.expect(p.contenido[0].nombreCompleto).to.eql('Ana María Muñoz Peña T' + sufijo));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
